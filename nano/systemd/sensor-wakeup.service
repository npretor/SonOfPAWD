[Unit]
Description=SonOfPAWD sensor-wakeup (PIR -> MQTT)
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/github/SonOfPAWD
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m nano.src.sensor_wakeup.main
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
